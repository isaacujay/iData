# ==============================================================================
# IDATA ENVIRONMENT CONFIGURATION
# ==============================================================================
# The site runs in Demo Mode if these variables are empty.
# Add your real values to connect Supabase database, live auth, and email notifications.

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, and Storage)
# Found in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# OWNER: Paste your Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# OWNER: Paste your Project anon (public) key (safe for the browser)
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. Public Site URL
# The canonical domain of your deployed application
# ------------------------------------------------------------------------------
# OWNER: Replace with your production domain (e.g. https://idata.agency)
VITE_SITE_URL=https://idata.agency

# ------------------------------------------------------------------------------
# 3. Calendly Booking URL (Optional override)
# Found in Calendly -> Share link
# ------------------------------------------------------------------------------
# OWNER: Paste your Calendly event link, or leave blank to use site.config.ts
VITE_CALENDLY_URL=https://calendly.com/idata-consulting/discovery-call

# ------------------------------------------------------------------------------
# 4. Email Notification Serverless Function (Vercel / Resend)
# Used only by the serverless api/notify.ts function (never exposed to browser)
# ------------------------------------------------------------------------------
# OWNER: The recipient email address where lead notifications will be sent
OWNER_EMAIL=issacujay@gmail.com

# OWNER: API Key from Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# OWNER: Verified sender address in Resend (e.g. notifications@idata.agency)
FROM_EMAIL=notifications@idata.agency

# ------------------------------------------------------------------------------
# 5. Security & Bot Prevention (Optional)
# ------------------------------------------------------------------------------
# OWNER: Cloudflare Turnstile Site Key for spam protection if enabled
VITE_TURNSTILE_SITE_KEY=
